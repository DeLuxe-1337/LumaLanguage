// selftest.luma - a self-checking Luma program.
//
// Each check is one call:  check(CONDITION, "description");
// A check passes only if CONDITION is exactly true. Failing checks print
// "FAIL: description". The program ends with a summary and
// "SELFTEST PASSED" (exit 0), or "SELFTEST FAILED" and exit status 1.
//
//   ./build/luma examples/selftest.luma -o build/selftest && ./build/selftest

var passed = 0;
var failed = 0;

fun check(ok, what) {
  if (ok == true) {
    passed = passed + 1;
  } else {
    failed = failed + 1;
    print("FAIL:", what);
  }
}

// ---------------------------------------------------------------- arithmetic
check(1 + 2 * 3 == 7, "* binds tighter than +");
check((1 + 2) * 3 == 9, "parentheses group");
check(10 - 4 - 3 == 3, "- is left associative");
check(100 / 10 / 5 == 2, "/ is left associative");
check(2 * -3 == -6, "unary minus operand");
check(--5 == 5, "double negation");
check(7 / 2 == 3, "7 / 2");
check(-7 / 2 == -4, "-7 / 2 floors toward -infinity");
check(7 / -2 == -4, "7 / -2 floors toward -infinity");
check(-7 / -2 == 3, "-7 / -2");
check(17 - 17 / 5 * 5 == 2, "17 mod 5 via floor division");
check(-17 - (-17 / 5) * 5 == 3, "-17 mod 5 is 3 (floor)");
check(0 * 12345 == 0, "multiply by zero");
check(2147483647 * 2147483647 == 4611686014132420609, "large product");
check(4611686018427387903 - 1 + 1 == 4611686018427387903, "max fixnum round trip");
check(-4611686018427387903 - 1 < 0, "min fixnum is negative");

// ---------------------------------------------------------------- comparison
check(1 < 2, "1 < 2");
check(!(2 < 1), "2 < 1 is false");
check(2 <= 2, "2 <= 2");
check(3 > 2, "3 > 2");
check(3 >= 3, "3 >= 3");
check(-1 < 0, "-1 < 0");
check(1 + 1 < 3 == true, "comparison binds tighter than ==");

// ---------------------------------------------------------------- equality and types
check(1 == 1, "1 == 1");
check(!(1 == 2), "1 == 2 is false");
check(!(1 == "1"), "number never equals string");
check(nil == nil, "nil == nil");
check(!(nil == false), "nil is not false");
check(!(true == 1), "true is not 1");
check(!(0 == false), "0 is not false");
check(true != false, "true != false");
check("ab" == "a" + "b", "strings compare by content");
check("" == "", "empty strings equal");
check("a" != "b", "different strings");

// ---------------------------------------------------------------- truthiness
check(!nil, "nil is falsy");
check(!false, "false is falsy");
check(!(!0), "0 is truthy");
check(!(!""), "empty string is truthy");
check(!!true == true, "!! produces a boolean");
var reached = false;
if (0) reached = true;
check(!(!reached), "if (0) takes the then branch");

// ---------------------------------------------------------------- and / or
check((nil or "d") == "d", "or returns right operand when left is falsy");
check(("x" or "y") == "x", "or returns left operand when truthy");
check((false and 1) == false, "and returns falsy left operand");
check((1 and 2) == 2, "and returns right operand");
check((nil and 1) == nil, "and preserves nil");
check((false or nil or 3) == 3, "or chains");
check((true or false and false) == true, "and binds tighter than or");
var hits = 0;
false and (hits = hits + 1);
true or (hits = hits + 1);
check(hits == 0, "short-circuit skips the right operand");
true and (hits = hits + 1);
false or (hits = hits + 10);
check(hits == 11, "right operand runs when needed");

// ---------------------------------------------------------------- strings
var s = "";
for (var i = 0; i < 3; i = i + 1) s = s + "ab";
check(s == "ababab", "concatenation in a loop");
check("" + "" == "", "empty concatenation");
check("a\"b" == "a" + "\"" + "b", "escaped quote");
check(!("\\" == "\\\\"), "escaped backslash");
check(!("tab\there" == "tab here"), "tab escape");
check("line\n" != "line", "newline escape");

// ---------------------------------------------------------------- scoping
var sc = "global";
{
  var sc = "block";
  check(sc == "block", "block shadows global");
  {
    var sc = "inner";
    check(sc == "inner", "nested shadowing");
  }
  check(sc == "block", "inner scope ends");
}
check(sc == "global", "global restored after block");
{
  sc = "changed";
}
check(sc == "changed", "block assigns to outer variable");
var rd = 1;
var rd = rd + 1;
check(rd == 2, "top-level redeclaration sees previous value");
var u;
check(u == nil, "uninitialized var is nil");

// ---------------------------------------------------------------- loops
var sum = 0;
var n = 1;
while (n <= 100) {
  sum = sum + n;
  n = n + 1;
}
check(sum == 5050, "while sums 1..100");
var fact = 1;
for (var k = 1; k <= 10; k = k + 1) fact = fact * k;
check(fact == 3628800, "for computes 10!");
var cells = 0;
for (var row = 0; row < 5; row = row + 1)
  for (var col = 0; col < 7; col = col + 1)
    cells = cells + 1;
check(cells == 35, "nested for loops");
var c = 0;
for (; c < 4;) c = c + 1;
check(c == 4, "for with only a condition");
var never = 0;
while (false) never = never + 1;
for (var z = 0; z < 0; z = z + 1) never = never + 1;
check(never == 0, "zero-iteration loops");
var fa = 0;
var fb = 1;
for (var step = 0; step < 89; step = step + 1) {
  var next = fa + fb;
  fa = fb;
  fb = next;
}
check(fb == 2880067194370816120, "fib(90) near the fixnum limit");
var ga = 1071;
var gb = 462;
while (gb != 0) {
  var tmp = gb;
  gb = ga - ga / gb * gb;
  ga = tmp;
}
check(ga == 21, "gcd(1071, 462)");
var primes = 0;
for (var cand = 2; cand < 100; cand = cand + 1) {
  var isprime = true;
  for (var d = 2; d * d <= cand and isprime; d = d + 1)
    if (cand - cand / d * d == 0) isprime = false;
  if (isprime) primes = primes + 1;
}
check(primes == 25, "25 primes below 100");

// ---------------------------------------------------------------- evaluation order
var x = 1;
check(x + (x = 10) == 11, "left operand evaluated before right");
check(x == 10, "assignment inside expression");
var y = 2;
check((y = 3) + y == 6, "assignment visible to right operand");
var p;
var q = p = 5;
check(p == 5 and q == 5, "chained assignment");
var a1 = 0;
var a2 = 0;
var a3 = 0;
a1 = a2 = a3 = 7;
check(a1 == 7 and a2 == 7 and a3 == 7, "assignment is right associative");

// ---------------------------------------------------------------- control flow
var de = 0;
if (true) if (false) de = 1; else de = 2;
check(de == 2, "else binds to the nearest if");
var chain = "";
if (nil) chain = "a"; else if (false) chain = "b"; else chain = "c";
check(chain == "c", "else-if chain");

// ---------------------------------------------------------------- functions
fun add(a, b) { return a + b; }
fun nothing() {}
fun early(n) { if (n > 0) return "positive"; return "not positive"; }
fun factorial(n) { if (n <= 1) return 1; return n * factorial(n - 1); }
fun rfib(n) { if (n < 2) return n; return rfib(n - 1) + rfib(n - 2); }
fun is_even(n) { if (n == 0) return true; return is_odd(n - 1); }
fun is_odd(n) { if (n == 0) return false; return is_even(n - 1); }
fun six(a, b, c, d, e, g) { return a - b + c - d + e - g; }
fun loop_return(limit) { for (var i = 0; ; i = i + 1) if (i * i > limit) return i; }
fun hoisted_caller() { return hoisted_callee() + 1; }
fun hoisted_callee() { return 41; }
check(add(2, 3) == 5, "call with arguments");
check(add("a", "b") == "ab", "dynamic typing through parameters");
check(nothing() == nil, "implicit return value is nil");
check(early(1) == "positive" and early(0) == "not positive", "early return");
check(factorial(20) == 2432902008176640000, "recursive factorial");
check(rfib(20) == 6765, "doubly recursive fibonacci");
check(is_even(50) and is_odd(51) and !is_odd(50), "mutual recursion");
check(six(1, 2, 3, 4, 5, 6) == -3, "six parameters arrive in order");
check(loop_return(1000) == 32, "return from inside a loop");
check(hoisted_caller() == 42, "functions are hoisted");
var g_count = 0;
fun g_bump() { g_count = g_count + 1; return g_count; }
g_bump();
g_bump();
check(g_count == 2 and g_bump() == 3, "functions update globals");
var g_shadow = "global";
fun g_param(g_shadow) { return g_shadow; }
check(g_param("param") == "param" and g_shadow == "global", "parameter shadows a global");
var trace = "";
fun mark(s) { trace = trace + s; return s; }
var joined = mark("a") + mark("b") + mark("c");
check(trace == "abc" and joined == "abc", "operands and calls evaluate left to right");
trace = "";
add(mark("x"), mark("y"));
check(trace == "xy", "arguments evaluate left to right");

// ---------------------------------------------------------------- summary
print("selftest:", passed, "passed,", failed, "failed");
if (failed == 0) {
  print("SELFTEST PASSED");
} else {
  print("SELFTEST FAILED");
  // Luma has no exit() yet: a deliberate runtime error makes the process exit with status 1.
  nil - 1;
}
