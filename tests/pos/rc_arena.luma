// Rc and arenas together (also in tests/mem with memcheck reports): here
// they run without memcheck, so arenas use their real chunk allocator.

// Arenas: everything a block allocates by hand (in this function or the ones
// it calls) goes into the arena and is freed at once when the arena's last
// reference goes away. Strings in their fields are released then too.
struct Node { value: int, label: str, next: Node? }

fun cat(a, b) { return a + b; }

fun build(n: int): Node? {
  var list: Node? = nil;
  for (var i = 0; i < n; i = i + 1) list = Node { value: i, label: cat("n", "#"), next: list };
  return list;
}

fun sum(list: Node?): int {
  var s = 0;
  while (list != nil) { s = s + list.value; list = list.next; }
  return s;
}

// scoped: the 1000 nodes built inside are freed when the block ends
var total = 0;
arena {
  var list = build(1000);
  total = sum(list);              // an int leaves the arena freely
}
print(total);

// code written to free by hand works unchanged inside an arena: free() of
// an instance that lives in one does nothing
fun destroy(list: Node?) {
  while (list != nil) {
    var next = list.next;
    free(list);
    list = next;
  }
}
arena {
  var l = build(100);
  destroy(l);
}

// an arena as a value: filled in two visits, then dropped
var level = arena {};
var map: Node? = nil;
arena level { map = build(10); }
arena level { map.next.value = 99; build(5); }
print(sum(map), level);
map = nil;
level = nil;                      // frees all 15 nodes

// a return from inside an arena block leaves the arena first
fun first_label(n: int): str {
  arena {
    var l = build(n);
    return cat(l.label, "!");     // a string survives the arena
  }
}
print(first_label(3));

// nested arenas
arena {
  var a = build(2);
  arena {
    var b = build(3);
    print(sum(b));
  }
  print(sum(a));
}

// Rc in detail: the value inside is reached through the box (fields,
// methods, assignment), statically when the type is known and dynamically
// otherwise; boxes of non-struct values; Rc::get; boxes in instances'
// fields; what each frees. (Rc::count is left out: it counts the references
// the program holds at that moment as compiled, and a reference ends at its
// last use, so its value depends on the optimization level.)
struct Point { x: int, y: int, label }
struct Holder { item: Rc<Point>, extra }

impl Point {
  fun len2(self): int { return self.x * self.x + self.y * self.y; }
  fun move(self, dx: int) { self.x = self.x + dx; }
}

fun dyn(x) { return x; }

fun counts() {
  var p = Rc::new(Point { x: 3, y: 4, label: cat("a", "b") });
  var q = p;
  print(p.x, q.len2(), p.label);                  // two variables share the box
  q.move(1);
  p.y = 10;
  print(Rc::get(p), q.y);
  var d = dyn(p);                                 // through an untyped value
  d.move(1);
  d.label = cat("c", "d");
  print(d.x, d.len2(), d.label);
  var h = Holder { item: p, extra: Rc::new(cat("x", "y")) };
  print(h.item.x, h.extra);
  free(h);                                        // releases both boxes it held
  print(p.x);
}
counts();

// an Rc from a value whose struct is known only at run time
var r = Rc::new(dyn(Point { x: 1, y: 1, label: nil }));
print(r, r.len2());
var s: Rc<any>? = Rc::new(cat("shared ", "text"));
print(s, Rc::get(s));
r = nil;
s = nil;
