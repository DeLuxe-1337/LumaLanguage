// The standard library: Math, Str and List (std/math.luma, str.luma, list.luma).
print(Math::abs(-5), Math::pow(2, 10), Math::gcd(12, 18), Math::lcm(4, 6), Math::isqrt(99), Math::mod(-7, 3), Math::digits(-12345));
var l: List<int> = List::new();
for (var i = 0; i < 10; i = i + 1) l.push(i * i);
print(l, l.len(), l.get(3), l.pop(), l.index_of(49), l.contains(5));
l.insert(0, -1); l.remove(2); l.reverse();
print(l);
var words = Str::split("the quick  brown fox", " ");
print(words, words.len());
print(Str::join(Str::words("  the quick  brown fox "), "-"), Str::upper("abc"), Str::trim("  x y  "));
print(Str::find("hello", "ll"), Str::slice("hello", 1, 3), Str::starts_with("hello", "he"), Str::ends_with("hello", "lo"));
print(Str::to_int("-42"), Str::to_int("4x"), Str::from_int(7) + "!", Str::repeat("ab", 3), Str::replace("a.b.c", ".", "::"));
print(Str::pad_left("7", 3, "0"), Str::count("banana", "an"), Str::of(12), Str::of("s"), Str::of(l));
var names: List<str> = List::new();
names.push("pear"); names.push("apple"); names.push("fig");
names.sort();
print(names, Str::lines("a\nb\r\nc\n"));
