// precedence, unary, floor division
print(1 + 2 * 3);
print((1 + 2) * 3);
print(10 - 4 - 3);
print(2 * -3);
print(--5);
print(7 / 2);
print(-7 / 2);
print(7 / -2);
print(-7 / -2);
print(0 - 4611686018427387903);
print(4611686018427387903);
print(-4611686018427387903 - 1);
print(3037000499 * 1518500249);
