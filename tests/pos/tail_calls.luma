// Deep tail recursion: compiled as jumps at -O1/-O2, so it needs no stack.
// (Typed: in untyped code n - 1 may be a boxed float, which the caller
// releases after the call returns, so such a call is not in tail position.)
fun count(n: int, acc: int): int {
    if (n == 0) return acc;
    return count(n - 1, acc + 2);
}
fun is_even(n: int): bool { if (n == 0) return true; return is_odd(n - 1); }
fun is_odd(n: int): bool { if (n == 0) return false; return is_even(n - 1); }
print(count(10000000, 0));
print(is_even(1000001), is_odd(1000001));
