// Shared ownership with Rc: a list whose head moves (dropped boxes free their
// nodes), boxes overwritten in fields, sharing, and cycles (reference
// counting cannot reclaim those: memcheck lists them as leaked).
struct Node { value: int, next: Rc<Node>? }
struct Pair { left, right }

fun push(list: Rc<Node>?, v: int): Rc<Node> { return Rc::new(Node { value: v, next: list }); }

var list: Rc<Node>? = nil;
for (var i = 0; i < 1000; i = i + 1) list = push(list, i);
for (var i = 0; i < 500; i = i + 1) list = list.next;     // drops 500 boxes and their nodes
var sum = 0;
var n = list;
while (n != nil) { sum = sum + n.value; n = n.next; }
print(sum);

var q: Rc<Pair> = Rc::new(Pair { left: nil, right: nil });
for (var i = 0; i < 10; i = i + 1) q.left = Rc::new(Pair { left: i, right: nil });   // 9 overwritten
var shared = Rc::new(Node { value: 7, next: nil });
q.right = Rc::new(Pair { left: shared, right: shared });   // one box, two references
shared = nil;
print(q.left.left, q.right.left.value);

var c = Rc::new(Pair { left: nil, right: nil });
c.right = c;           // a cycle of one: the box refers to itself through its value
c = nil;

fun ring() {           // a cycle of two that only refers to itself
  var a = Rc::new(Pair { left: nil, right: nil });
  var b = Rc::new(Pair { left: a, right: nil });
  a.right = b;
}
ring();

list = nil;
n = nil;
