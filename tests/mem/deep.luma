// Dropping the last reference to the head of a million-node Rc list frees
// every box and node. The runtime frees iteratively, so the depth of the
// structure never reaches the C stack.
struct Node { value: int, next: Rc<Node>? }

fun build(n: int): Rc<Node>? {
  var list: Rc<Node>? = nil;
  for (var i = 0; i < n; i = i + 1) list = Rc::new(Node { value: i, next: list });
  return list;
}

var list = build(1000000);
print(list.value);
list = nil;
print("released");
